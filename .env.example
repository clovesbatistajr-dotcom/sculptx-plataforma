# ═══════════════════════════════════════════════════════════════════
# SCULPTX PLATAFORMA - CONFIGURAÇÃO DE AMBIENTE
# ═══════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e configure com seus dados

# ═══════════════════════════════════════════════════════════════════
# BANCO DE DADOS
# ═══════════════════════════════════════════════════════════════════

# Formato: postgresql://usuario:senha@host:porta/banco
# Exemplo local: postgresql://postgres:senha@localhost:5432/sculptx_db
# Exemplo Render: postgresql://user:password@host.render.com:5432/db_name
DATABASE_URL=postgresql://user:password@localhost:5432/sculptx_db

# ═══════════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════════

# Porta do servidor (Render define automaticamente)
PORT=3000

# Ambiente: development ou production
NODE_ENV=development

# Senha do painel admin (MUDE PARA ALGO SEGURO!)
ADMIN_PASSWORD=01010924Clo#

# ═══════════════════════════════════════════════════════════════════
# SEGURANÇA
# ═══════════════════════════════════════════════════════════════════

# Origens permitidas para CORS (separadas por vírgula)
# ALLOWED_ORIGINS=http://localhost:3000,https://www.seudominio.com
ALLOWED_ORIGINS=*

# ═══════════════════════════════════════════════════════════════════
# DICAS PARA RENDER.COM
# ═══════════════════════════════════════════════════════════════════
# 1. DATABASE_URL: Cole a URL do PostgreSQL do Render
# 2. ADMIN_PASSWORD: Configure uma senha forte
# 3. NODE_ENV: Use 'production' no Render
# 4. PORT: Deixe vazio (Render define automaticamente)
